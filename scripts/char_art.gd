## Sprite name -> [rows, colors], for TileFactory.character().
static func lookup(name: String) -> Array:
	match name:
		"hero_oracleborn_sprite": return [HERO, HERO_C]
		"hero_oracleborn_portrait": return [PORTRAIT, PORTRAIT_C]
		"hero_engineer_sprite": return [ENGINEER, ENGINEER_C]
		"hero_engineer_portrait": return [ENG_PORTRAIT, ENG_PORTRAIT_C]
		"hero_alysia_sprite": return [ALYSIA, ALYSIA_C]
		"hero_alysia_portrait": return [ALY_PORTRAIT, ALY_PORTRAIT_C]
		"npc_player": return [PLAYER, PLAYER_C]
		"enemy_restless_dead": return [DEAD, DEAD_C]
		"enemy_drifter_raider": return [RAIDER, RAIDER_C]
		"enemy_frost_wraith": return [WRAITH, WRAITH_C]
		"enemy_afterimage_guard": return [GUARD, GUARD_C]
		"enemy_afterimage_echo": return [ECHO, ECHO_C]
		"enemy_armored_man": return [ARMORED, ARMORED_C]
		"enemy_mastiff": return [MASTIFF, MASTIFF_C]
		"enemy_sentry": return [SENTRY, SENTRY_C]
		"enemy_hound": return [HOUND, HOUND_C]
		"enemy_wisp": return [WISP, WISP_C]
		"enemy_drone": return [DRONE, DRONE_C]
		"enemy_unmoored": return [UNMOORED, UNMOORED_C]
	return [DEAD, DEAD_C]
